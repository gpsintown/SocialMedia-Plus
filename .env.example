# Optional LinkedIn developer credentials. Public blank template only.
# Prefer Dashboard > LinkedIn settings to save these in ignored .env.local.
# If copying manually: cp .env.example .env.local && chmod 600 .env.local
# Do not source this file as a shell script or paste real secrets into Git.
# Saving these settings does not complete OAuth; API adapters are planned.

# App 1: Sign In with LinkedIn using OpenID Connect
LINKEDIN_IDENTITY_CLIENT_ID=""
LINKEDIN_IDENTITY_CLIENT_SECRET=""
# Reserved example only: no callback handler ships in this version.
LINKEDIN_IDENTITY_REDIRECT_URI="http://127.0.0.1:4010/auth/linkedin/identity/callback"

# App 2: Share on LinkedIn
LINKEDIN_PUBLISH_CLIENT_ID=""
LINKEDIN_PUBLISH_CLIENT_SECRET=""
LINKEDIN_PUBLISH_REDIRECT_URI="http://127.0.0.1:4010/auth/linkedin/publish/callback"
